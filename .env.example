# Atlas frontend env (Vite) — only VITE_ vars reach the browser bundle.
# NOTHING sensitive here by design: no service-role key, no Anthropic key.
# Those live ONLY in the Worker.
#
# Copy to .env and fill in from your Supabase project settings (Project
# Settings → API). The anon key is the public client key — but each
# environment must point at its OWN project, so no real values are pinned here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ATLAS_API_URL=
